{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanguo-editor.local/schema/character.schema.json",
  "title": "CharacterExport",
  "description": "人物导出契约。属于冻结包 schema_version=1.12.0。code 在 base 内。演义引文不得写入 historical。",
  "type": "object",
  "required": ["id", "base", "historical", "game"],
  "properties": {
    "id": { "type": "string" },
    "project_id": { "type": "string" },
    "base": {
      "type": "object",
      "required": ["code", "name", "gender"],
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "courtesy_name": { "type": ["string", "null"] },
        "gender": { "enum": ["male", "female", "unknown"] },
        "birth_year": { "type": ["integer", "null"] },
        "death_year": { "type": ["integer", "null"] },
        "birthplace": { "type": ["string", "null"] },
        "ethnicity": { "type": ["string", "null"] },
        "identity": { "type": ["string", "null"] }
      }
    },
    "historical": {
      "type": "object",
      "description": "历史事实，禁止写入游戏数值，也禁止写入三国演义情节",
      "properties": {
        "biography": { "type": ["string", "null"] },
        "family_background": { "type": ["string", "null"] },
        "life_experience": { "type": ["string", "null"] },
        "achievements": { "type": ["string", "null"] },
        "historical_evaluation": { "type": ["string", "null"] }
      }
    },
    "game": {
      "type": "object",
      "description": "游戏设定，可因平衡性调整。客户端只读，不在编辑器内结算。",
      "properties": {
        "force": { "type": "integer", "minimum": 0, "maximum": 100 },
        "intelligence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "politics": { "type": "integer", "minimum": 0, "maximum": 100 },
        "charisma": { "type": "integer", "minimum": 0, "maximum": 100 },
        "leadership": { "type": "integer", "minimum": 0, "maximum": 100 },
        "stamina": { "type": "integer", "minimum": 0, "maximum": 100 },
        "morale": { "type": "integer", "minimum": 0, "maximum": 100 },
        "mobility": { "type": "integer", "minimum": 0, "maximum": 100 },
        "personality_tag_codes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "portrait": { "type": ["object", "null"] },
        "model": { "type": ["object", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "description": "人物引文。bound_layer=historical 的条目必须来自正史/史书/论文/学术资料。",
      "items": {
        "type": "object",
        "required": ["source_code", "bound_layer"],
        "properties": {
          "source_code": { "type": "string" },
          "source_name": { "type": "string" },
          "source_type": { "type": "string" },
          "bound_layer": { "enum": ["historical", "literary", "game"] },
          "quotation": { "type": ["string", "null"] },
          "reference": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
