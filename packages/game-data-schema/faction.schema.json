{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanguo-editor.local/schema/faction.schema.json",
  "title": "FactionExport",
  "description": "势力导出契约。属于冻结包 schema_version=1.12.0。分区项为 {faction, members, territories}。不预置魏蜀吴。",
  "type": "object",
  "required": ["faction"],
  "properties": {
    "faction": {
      "type": "object",
      "required": ["id", "code", "name"],
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "leader": { "type": ["object", "null"] },
        "capital": { "type": ["object", "null"] },
        "start_year": { "type": ["integer", "null"] },
        "end_year": { "type": ["integer", "null"] },
        "historical_description": { "type": ["string", "null"] }
      }
    },
    "members": { "type": "array" },
    "territories": { "type": "array" }
  }
}
