{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanguo-editor.local/schema/map.schema.json",
  "title": "MapExport",
  "description": "地图导出契约。属于冻结包 schema_version=1.12.0。分区项为 {map, terrain}；未覆盖格子使用 default_terrain。",
  "type": "object",
  "required": ["map"],
  "properties": {
    "map": {
      "type": "object",
      "required": ["id", "code", "name", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "width": { "type": "integer", "minimum": 4, "maximum": 256 },
        "height": { "type": "integer", "minimum": 4, "maximum": 256 },
        "cell_size": { "type": "integer" },
        "default_terrain": {
          "enum": ["plain", "forest", "hill", "mountain", "water", "swamp", "desert", "pass", "farmland", "urban"]
        },
        "description": { "type": ["string", "null"] },
        "features": { "type": "array" },
        "cities": { "type": "array" }
      }
    },
    "terrain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x", "y", "terrain"],
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "terrain": { "type": "string" }
        }
      }
    }
  }
}
