{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanguo-editor.local/schema/relationship.schema.json",
  "title": "CharacterRelationshipExport",
  "description": "人物关系导出契约。schema_version=1.3.0。对称关系导出一条主边即可，客户端可自行补反向。",
  "type": "object",
  "required": ["schema_version", "id", "from_character_code", "to_character_code", "relationship_type"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.3.0" },
    "id": { "type": "string" },
    "from_character_code": { "type": "string" },
    "to_character_code": { "type": "string" },
    "relationship_type": {
      "enum": [
        "kinship",
        "marriage",
        "sworn",
        "ruler_subject",
        "master_servant",
        "mentor_student",
        "rival",
        "alliance"
      ]
    },
    "symmetric": { "type": "boolean" },
    "intimacy": { "type": "integer", "minimum": 0, "maximum": 100 },
    "hostility": { "type": "integer", "minimum": 0, "maximum": 100 },
    "start_year": { "type": ["integer", "null"] },
    "end_year": { "type": ["integer", "null"] },
    "note": { "type": ["string", "null"] }
  }
}
