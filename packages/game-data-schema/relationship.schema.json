{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanguo-editor.local/schema/relationship.schema.json",
  "title": "CharacterRelationshipExport",
  "description": "人物关系导出契约。属于冻结包 schema_version=1.12.0。对称关系导出一条主边即可。",
  "type": "object",
  "required": ["id", "from_character", "to_character", "relationship_type"],
  "properties": {
    "id": { "type": "string" },
    "from_character": {
      "type": "object",
      "required": ["id", "code", "name"],
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "to_character": {
      "type": "object",
      "required": ["id", "code", "name"],
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "relationship_type": {
      "enum": [
        "kinship",
        "marriage",
        "sworn",
        "ruler_subject",
        "master_servant",
        "mentor_student",
        "rival",
        "alliance"
      ]
    },
    "symmetric": { "type": "boolean" },
    "intimacy": { "type": "integer", "minimum": 0, "maximum": 100 },
    "hostility": { "type": "integer", "minimum": 0, "maximum": 100 },
    "start_year": { "type": ["integer", "null"] },
    "end_year": { "type": ["integer", "null"] },
    "note": { "type": ["string", "null"] }
  }
}
