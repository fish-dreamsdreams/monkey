{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanguo-editor.local/schema/skill.schema.json",
  "title": "SkillExport",
  "description": "技能导出契约。属于冻结包 schema_version=1.12.0。effects 仅为数据，客户端解释执行，编辑器不结算伤害。",
  "type": "object",
  "required": ["id", "code", "name", "skill_type", "effects"],
  "properties": {
    "id": { "type": "string" },
    "code": { "type": "string" },
    "name": { "type": "string" },
    "skill_type": { "enum": ["active", "passive", "command", "domestic"] },
    "description": { "type": ["string", "null"] },
    "target": {
      "enum": ["self", "ally", "enemy", "all_allies", "all_enemies", "tile", "none"]
    },
    "cooldown": { "type": "integer", "minimum": 0 },
    "cost": {
      "type": "object",
      "properties": {
        "resource": { "enum": ["none", "stamina", "morale"] },
        "amount": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "trigger_condition": {
      "type": ["object", "null"],
      "properties": {
        "event": { "type": "string" },
        "threshold": { "type": ["integer", "null"] }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": [
              "modify_stat",
              "deal_damage",
              "heal",
              "apply_status",
              "move",
              "reveal",
              "gain_resource"
            ]
          },
          "target": { "type": "string" },
          "stat": { "type": ["string", "null"] },
          "delta": { "type": ["integer", "null"] },
          "amount": { "type": ["integer", "null"] },
          "status_code": { "type": ["string", "null"] },
          "duration": { "type": ["integer", "null"] },
          "params": { "type": "object" }
        }
      }
    },
    "historical_basis": {
      "type": ["object", "null"],
      "properties": {
        "source_type": { "type": ["string", "null"] },
        "source_code": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
