{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanguo-editor.local/schema/story.schema.json",
  "title": "StoryExport",
  "description": "剧情导出契约。属于冻结包 schema_version=1.12.0。节点图属于游戏叙事层。无条件边禁止成环；条件回边必须带终止条件。",
  "type": "object",
  "required": ["id", "code", "name", "nodes"],
  "properties": {
    "id": { "type": "string" },
    "code": { "type": "string" },
    "name": { "type": "string" },
    "layer": { "enum": ["literary", "game"] },
    "description": { "type": ["string", "null"] },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "code", "name", "node_type"],
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "node_type": {
            "enum": [
              "dialogue",
              "historical_event",
              "battle",
              "quest",
              "character_join",
              "character_leave",
              "city_capture",
              "faction_create",
              "faction_destroy",
              "choice",
              "condition",
              "reward"
            ]
          },
          "is_entry": { "type": "boolean" },
          "is_ending": { "type": "boolean" },
          "body": { "type": ["string", "null"] },
          "event_id": { "type": ["string", "null"] },
          "next_node_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
